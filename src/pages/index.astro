---
import Layout from "../layouts/Layout.astro";
import PhoneMockup from "../components/PhoneMockup.astro";

const features = [
  { n: "01", title: "Patterns", desc: "Build repeating routines anchored to real methods, days, and times." },
  { n: "02", title: "Progress", desc: "Earn points, climb levels, and watch your consistency compound." },
  { n: "03", title: "Groups",   desc: "Train alongside others on the same path. Accountability at scale." },
];

const stats: [string, string][] = [
  ["14", "Day streak"],
  ["L8", "Top level"],
  ["3×", "Daily avg"],
];

const year = new Date().getFullYear();
---

<Layout>
  <main class="bg-white text-[#0d0d0d] overflow-x-hidden">

    <!-- Nav -->
    <nav class="border-b-[3px] border-[#0d0d0d]">
      <div class="max-w-7xl mx-auto px-8 flex items-center justify-between h-16">
        <span class="text-xl font-black tracking-tight uppercase">Paths</span>
        <div class="hidden sm:flex items-center gap-8">
          <a href="#features"  class="text-xs font-black uppercase tracking-widest hover:text-[#d62828] transition-colors">Features</a>
          <a href="#about"     class="text-xs font-black uppercase tracking-widest hover:text-[#d62828] transition-colors">About</a>
          <a href="#manifesto" class="text-xs font-black uppercase tracking-widest hover:text-[#d62828] transition-colors">Manifesto</a>
          <a href="#download"  class="text-xs font-black uppercase tracking-widest hover:text-[#d62828] transition-colors">Download</a>
        </div>
        <a
          href="#download"
          class="flex items-center gap-2 bg-[#0d0d0d] text-white px-5 py-2.5 text-xs font-black uppercase tracking-widest hover:bg-[#d62828] transition-colors"
        >
          <img src="/apple-logo-white.svg" alt="" width="13" height="13" />
          App Store
        </a>
      </div>
    </nav>

    <!-- Hero -->
    <section class="max-w-7xl mx-auto px-8 min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-2 items-center">
      <div class="py-20 lg:py-0 lg:pr-20">
        <p class="text-[11px] font-black uppercase tracking-[0.3em] text-[#d62828] mb-8">
          iOS App &nbsp;&mdash;&nbsp; Habit Tracker
        </p>
        <h1 class="text-[clamp(4rem,9vw,7rem)] font-black leading-[0.88] tracking-tight uppercase mb-10">
          Join the<br />
          <span class="text-[#d62828]">revolution.</span>
        </h1>
        <p class="text-base text-[#0d0d0d]/50 leading-relaxed max-w-xs mb-12">
          Paths structures your day around patterns &mdash; recurring habits
          tied to methods, times, and real intention.
          Track, level up, train alongside a community.
        </p>
        <a
          href="https://apps.apple.com"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 bg-[#0d0d0d] text-white px-8 py-5 font-black text-xs uppercase tracking-widest hover:bg-[#d62828] transition-colors"
        >
          <img src="/apple-logo-white.svg" alt="Apple" width="18" height="18" />
          Download on the App Store
        </a>
      </div>

      <div class="relative flex items-center justify-center py-20 lg:py-0 min-h-[600px]">
        <div class="absolute right-0 top-1/2 -translate-y-1/2 w-[72%] h-[80%] bg-[#d62828]"></div>
        <div class="absolute left-[18%] top-1/2 -translate-y-1/2 w-[3px] h-[65%] bg-[#0d0d0d]"></div>
        <div class="relative z-10">
          <PhoneMockup />
        </div>
      </div>
    </section>

    <!-- Features -->
    <section id="features" class="border-t-[3px] border-[#0d0d0d]">
      <div class="max-w-7xl mx-auto px-8 grid grid-cols-1 sm:grid-cols-3">
        {features.map((f, i) => (
          <div class={`py-14 px-10 ${i < 2 ? "sm:border-r-[3px] border-[#0d0d0d]" : ""}`}>
            <p class="text-6xl font-black text-[#d62828]/15 leading-none mb-6 select-none">{f.n}</p>
            <h3 class="text-2xl font-black uppercase tracking-tight mb-4">{f.title}</h3>
            <p class="text-sm text-[#0d0d0d]/45 leading-relaxed">{f.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- About -->
    <section id="about" class="border-t-[3px] border-[#0d0d0d] bg-[#0d0d0d] text-white">
      <div class="max-w-7xl mx-auto px-8 py-28 grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
        <div>
          <p class="text-[11px] font-black uppercase tracking-[0.3em] text-[#d62828] mb-8">About Paths</p>
          <h2 class="text-[clamp(3rem,6vw,5.5rem)] font-black uppercase tracking-tight leading-[0.9]">
            Structure<br />
            is the<br />
            <span class="text-[#d62828]">discipline.</span>
          </h2>
        </div>
        <div class="space-y-6">
          <p class="text-lg text-white/55 leading-relaxed">
            Most habit apps reward activity. Paths rewards architecture.
            You define the pattern &mdash; the what, the when, the method &mdash;
            and then you execute. Repeat. Compound.
          </p>
          <p class="text-lg text-white/55 leading-relaxed">
            Progress is measured in levels earned, groups joined,
            and practices that become part of who you are.
          </p>
          <div class="pt-4 border-t border-white/15 grid grid-cols-3 gap-8">
            {stats.map(([val, lbl]) => (
              <div>
                <p class="text-3xl font-black text-[#d62828]">{val}</p>
                <p class="text-xs font-black uppercase tracking-widest text-white/35 mt-1">{lbl}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Manifesto -->
    <section id="manifesto" class="border-t-[3px] border-[#0d0d0d]">
      <div class="max-w-7xl mx-auto px-8 py-28 grid grid-cols-1 lg:grid-cols-2 gap-20">
        <div>
          <p class="text-[11px] font-black uppercase tracking-[0.3em] text-[#d62828] mb-8">Manifesto</p>
          <h2 class="text-[clamp(3rem,6vw,5.5rem)] font-black uppercase tracking-tight leading-[0.9]">
            Why<br />
            we<br />
            <span class="text-[#d62828]">build.</span>
          </h2>
        </div>
        <div class="space-y-6 pt-2">
          <p class="text-lg text-[#0d0d0d]/55 leading-relaxed">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. In varius diam justo, id sagittis ipsum dictum feugiat. Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium.
          </p>
          <p class="text-lg text-[#0d0d0d]/55 leading-relaxed">
            Nemo enim ipsam voluptatem quia voluptas sit aspernatur aut odit aut fugit, sed quia consequuntur magni dolores eos qui ratione voluptatem sequi nesciunt.
          </p>
          <p class="text-lg text-[#0d0d0d]/55 leading-relaxed">
            Ut enim ad minima veniam, quis nostrum exercitationem ullam corporis suscipit laboriosam, nisi ut aliquid ex ea commodi consequatur.
          </p>
        </div>
      </div>
    </section>

    <!-- Download CTA -->
    <section id="download" class="border-t-[3px] border-[#0d0d0d]">
      <div class="max-w-7xl mx-auto px-8 py-36 flex flex-col items-center text-center">
        <p class="text-[11px] font-black uppercase tracking-[0.3em] text-[#d62828] mb-8">
          Available Now on iOS
        </p>
        <h2 class="text-[clamp(4rem,10vw,8rem)] font-black uppercase tracking-tight leading-[0.88] mb-14">
          Start<br />today.
        </h2>
        <a
          href="https://apps.apple.com"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-4 bg-[#0d0d0d] text-white px-12 py-6 font-black text-sm uppercase tracking-widest hover:bg-[#d62828] transition-colors"
        >
          <img src="/apple-logo-white.svg" alt="Apple" width="22" height="22" />
          Download on the App Store
        </a>
      </div>
    </section>

    <!-- Footer -->
    <footer class="border-t-[3px] border-[#0d0d0d]">
      <div class="max-w-7xl mx-auto px-8 py-6 flex items-center justify-between">
        <span class="text-sm font-black uppercase tracking-tight">Paths</span>
        <p class="text-xs text-[#0d0d0d]/30 font-semibold">
          &copy; {year} Paths. All rights reserved.
        </p>
      </div>
    </footer>

  </main>
</Layout>
