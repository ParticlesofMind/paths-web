---
// Shell for long-form legal text: the Terms of Use and the Privacy Policy.
// One readable column of plain prose. Each page passes its sections as the
// default slot and its "last updated" date in the `updated` slot.
//
// Facts the author still has to settle are written as
// <mark>[TO CONFIRM: ...]</mark>, so they stand out on the page and can be
// found by searching for "TO CONFIRM". While `draft` is set, a notice above
// the title says the page is not approved.
interface Props {
  title: string;
  draft?: boolean;
}
const { title, draft = false } = Astro.props;
---

<article class="legal mx-auto max-w-2xl px-4 py-16">
  {
    draft && (
      <p class="legal-draft">
        Draft for review. Not yet approved. Every item marked TO CONFIRM must be settled before this page goes live.
      </p>
    )
  }
  <h1 class="text-4xl font-bold">{title}</h1>
  <p class="mt-3 text-ink-60">Last updated: <slot name="updated" /></p>
  <div class="legal-body mt-10">
    <slot />
  </div>
</article>

<style>
  .legal-draft {
    margin-bottom: 2rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--site-ochre);
    border-radius: 0.5rem;
    background: var(--site-surface);
    color: var(--site-ink);
  }

  .legal-body {
    line-height: 1.65;
  }

  .legal-body :global(h2) {
    margin-top: 2.5rem;
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.3;
    scroll-margin-top: 7rem;
  }

  .legal-body :global(h3) {
    margin-top: 1.75rem;
    font-size: 1.125rem;
    font-weight: 600;
  }

  .legal-body :global(p) {
    margin-top: 1rem;
  }

  .legal-body :global(ul) {
    margin-top: 0.75rem;
    padding-left: 1.25rem;
    list-style: disc;
  }

  .legal-body :global(li) {
    margin-top: 0.4rem;
  }

  .legal-body :global(a) {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .legal-body :global(strong) {
    font-weight: 600;
  }

  .legal :global(mark) {
    padding: 0 0.2em;
    border-radius: 0.2em;
    background: var(--site-ochre);
    color: var(--site-ink);
  }
</style>
